{%- capture tp_no -%}<svg class="tp-no" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-label="No"><path d="M6 6l12 12M18 6 6 18"/></svg>{%- endcapture -%}
