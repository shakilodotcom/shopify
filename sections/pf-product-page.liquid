<script>
/* DropMagic-style bundle picker: card selection and text-button option toggles. */
(function () {
  if (window.__pflBundleLoaded) return;
  window.__pflBundleLoaded = true;

  function selectBar(bundle, card) {
    bundle.querySelectorAll('[data-bundle-bar]').forEach(function (c) {
      c.setAttribute('data-active', c === card ? 'true' : 'false');
    });
  }

  function init(bundle) {
    if (bundle.__pflReady) return;
    bundle.__pflReady = true;
    var cards = bundle.querySelectorAll('[data-bundle-bar]');
    if (!cards.length) return;
    var pre = null;
    try {
      var raw = JSON.parse(bundle.getAttribute('data-bars') || '[]');
      (Array.isArray(raw) ? raw : raw.items || []).some(function (b) { return b.isPreselected && (pre = b.id); });
    } catch (e) {}
    var chosen = pre && bundle.querySelector('[data-bundle-bar][data-bar-id="' + pre + '"]');
    selectBar(bundle, chosen || cards[0]);

    bundle.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-unit-value]');
      if (btn && bundle.contains(btn)) {
        var wrap = btn.closest('[data-unit-opt]');
        var sel = wrap && wrap.querySelector('select');
        if (sel && sel.value !== btn.getAttribute('data-unit-value')) {
          sel.value = btn.getAttribute('data-unit-value');
          sel.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
      var card = e.target.closest('[data-bundle-bar]');
      if (card && bundle.contains(card)) selectBar(bundle, card);
    });

    bundle.addEventListener('change', function (e) {
      var wrap = e.target.closest && e.target.closest('[data-unit-opt]');
      if (!wrap) return;
      wrap.querySelectorAll('[data-unit-value]').forEach(function (b) {
        if (b.getAttribute('data-unit-value') === e.target.value) b.setAttribute('data-selected', '');
        else b.removeAttribute('data-selected');
      });
    });
  }

  function run() { document.querySelectorAll('.pfl-dmb dm-bundle').forEach(init); }
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
})();
</script>
<script>
(function(){
var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return [].slice.call((r||document).querySelectorAll(s))};
var slides=$("#tpSlides"),thumbs=$("#tpThumbs");
function go(i){slides.scrollTo({left:i*slides.clientWidth,behavior:"smooth"})}
$$("button",thumbs).forEach(function(b){b.onclick=function(){go(+b.dataset.i)}});
slides.addEventListener("scroll",function(){
var i=Math.round(slides.scrollLeft/slides.clientWidth);
$$("button",thumbs).forEach(function(b,j){b.classList.toggle("tp-on",i===j)});
},{passive:true});
$$("[data-thumbs]").forEach(function(b){b.onclick=function(){
var n=slides.children.length,i=Math.round(slides.scrollLeft/slides.clientWidth)+(+b.dataset.thumbs);go((i+n)%n);
thumbs.scrollBy({left:+b.dataset.thumbs*112})}});
var sel={size:TPF.sizes[0],side:TPF.sides[0]};
function pills(el,list,key){
el.innerHTML=list.map(function(v,i){return '<button type="button"'+(i?'':' class="tp-on"')+'>'+v+'</button>'}).join("");
$$("button",el).forEach(function(b){b.onclick=function(){
sel[key]=b.textContent;$$("button",el).forEach(function(x){x.classList.toggle("tp-on",x===b)});
$$('.pfl-dmb select[data-option-index="'+(key==="size"?0:1)+'"]').forEach(function(s){s.value=sel[key];s.dispatchEvent(new Event("change",{bubbles:true}))});
}});
}
pills($("#tpSize"),TPF.sizes,"size");pills($("#tpSide"),TPF.sides,"side");
function openCart(){
if(document.querySelector('dm-sheet[data-sheet-open-on="cart"]'))return;
var hz=document.querySelector("cart-drawer-component");
if(hz){
var sec=hz.closest('[id^="shopify-section-"]'),id=sec&&sec.id.replace("shopify-section-","");
fetch(location.pathname+"?sections="+id).then(function(r){return r.json()}).then(function(d){
if(d&&d[id]){var n=new DOMParser().parseFromString(d[id],"text/html").querySelector("cart-drawer-component");if(n)hz.replaceWith(n),hz=n}
}).catch(function(){}).then(function(){(hz.open||hz.showDialog||function(){location.href=TPF.root+"cart"}).call(hz)});
return;
}
location.href=TPF.root+"cart";
}
var atc=$("#tpAtc");
function addToCart(){
var card=$('.pfl-dmb [data-bundle-bar][data-active="true"]'),barId=card&&card.getAttribute("data-bar-id"),items=[];
if(!card){var v=TPF.variants[sel.size+" / "+sel.side];if(v)items.push({id:v,quantity:1})}
(card?$$("[data-bundle-unit]",card):[]).map(function(u){
var o=function(i){var x=$('select[data-option-index="'+i+'"]',u);return x?x.value:""};return {id:TPF.variants[o(0)+" / "+o(1)],quantity:1,properties:{_bundle_type:u.getAttribute("data-unit-role"),_bar_id:barId}};
}).filter(function(l){return l.id}).sort(function(a,b){return (a.properties._bundle_type==="get"?0:1)-(b.properties._bundle_type==="get"?0:1)})
.forEach(function(l){
var m=items.filter(function(x){return x.id===l.id&&x.properties._bundle_type===l.properties._bundle_type})[0];
m?m.quantity++:items.push(l);
});
atc.disabled=true;atc.textContent="Adding…";
(TPF.discountCode?fetch(TPF.root+"discount/"+encodeURIComponent(TPF.discountCode)):Promise.resolve())
.then(function(){return fetch(TPF.root+"cart/add.js",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:items})})})
.then(function(r){if(!r.ok)throw r;return r.json()})
.then(function(){atc.disabled=false;atc.textContent="Add to cart";openCart()})
.catch(function(){atc.disabled=false;atc.textContent="Add to cart";alert("Sorry, that size is unavailable. Please choose another.")});
}
atc.onclick=addToCart;
$("#tpStickyAtc").onclick=addToCart;
$$("[data-open]").forEach(function(b){b.onclick=function(){var d=document.getElementById(b.dataset.open);d.showModal?d.showModal():d.setAttribute("open","")}});
$$(".tpf dialog").forEach(function(d){
$$("[data-close]",d).forEach(function(b){b.onclick=function(){d.close()}});
d.addEventListener("click",function(e){if(e.target===d)d.close()});
});
var bar=$("#tpSticky");
new IntersectionObserver(function(e){bar.classList.toggle("tp-show",!e[0].isIntersecting&&e[0].boundingClientRect.top<0)}).observe(atc);
})();
</script>
