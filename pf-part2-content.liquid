<script>
(function(){
var t=document.getElementById("tpcTrack"),num=document.getElementById("tpcNum");
function step(){return t.firstElementChild.offsetWidth+20}
document.querySelectorAll("[data-tst]").forEach(function(b){b.onclick=function(){t.scrollBy({left:+b.dataset.tst*step(),behavior:"smooth"})}});
t.addEventListener("scroll",function(){num.textContent=Math.min(3,Math.round(t.scrollLeft/step())+1)},{passive:true});
})();
