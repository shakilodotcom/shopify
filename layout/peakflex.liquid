<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
{{ 'peakflex.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<header>
  <div class="wrap hdr">
    <button class="menu-btn" aria-label="Menu" onclick="document.getElementById('mnav').classList.toggle('open')">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="logo" href="{{ routes.root_url }}">PeakFlex</a>
    <nav><a href="{{ routes.root_url }}">Home</a><a href="#buy">Try Now</a><a href="/pages/contact">Contact</a></nav>
    <a href="{{ routes.cart_url }}" aria-label="Cart"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h2l2.4 11h11L21 7H6.2"/><circle cx="9" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg></a>
  </div>
  <div id="mnav"><a href="{{ routes.root_url }}">Home</a><a href="#buy">Shop</a><a href="/pages/contact">Contact</a></div>
</header>

<main>
{{ content_for_layout }}
</main>

<footer>
  <div class="wrap">
    <div class="foot">
      <div class="logo">PeakFlex</div>
      <div><h5>Navigation</h5><ul><li><a href="#buy">Try it now</a></li></ul></div>
      <div><h5>Support</h5><ul><li><a href="/policies/shipping-policy">Shipping</a></li><li><a href="/policies/refund-policy">Returns</a></li><li><a href="/pages/contact">Contact</a></li></ul></div>
    </div>
    <div class="foot-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Free shipping and secure checkout.</span>
      <div class="pay">
        <img src="{{ 'pay-amazon.svg' | asset_url }}" alt="Amazon"><img src="{{ 'pay-american_express.svg' | asset_url }}" alt="American Express"><img src="{{ 'pay-apple_pay.svg' | asset_url }}" alt="Apple Pay"><img src="{{ 'pay-diners_club.svg' | asset_url }}" alt="Diners Club"><img src="{{ 'pay-discover.svg' | asset_url }}" alt="Discover"><img src="{{ 'pay-google_pay.svg' | asset_url }}" alt="Google Pay"><img src="{{ 'pay-jcb.svg' | asset_url }}" alt="JCB"><img src="{{ 'pay-master.svg' | asset_url }}" alt="Mastercard"><img src="{{ 'pay-paypal.svg' | asset_url }}" alt="PayPal"><img src="{{ 'pay-shopify_pay.svg' | asset_url }}" alt="Shop Pay"><img src="{{ 'pay-visa.svg' | asset_url }}" alt="Visa">
      </div>
    </div>
  </div>
</footer>

{% if template.name == 'product' %}
<div class="sticky-bar" id="stickyBar">
  <img src="{{ product.featured_image | image_url: width: 120 }}" alt="">
  <div class="t">{{ product.title | escape }}<br><span style="color:var(--muted)">{{ product.price | money }}</span></div>
  <a class="btn" href="#buy">Get yours</a>
</div>

{% endif %}
</body>
</html>
