.pf .sticky-bar{position:fixed;left:0;right:0;bottom:0;z-index:25;background:#fff;border-top:1px solid var(--border);padding:10px 16px;display:flex;gap:12px;align-items:center;transform:translateY(110%);transition:transform .25s}.pf .sticky-bar.show{transform:none}.pf .sticky-bar img{width:44px;height:44px;border-radius:6px;object-fit:cover}.pf .sticky-bar .t{flex:1;font-size:14px;font-weight:500;line-height:1.3}.pf .sticky-bar .btn{padding:10px 22px}
.pf{font-family:"Inter",sans-serif;line-height:1.5}.pf .pay svg{height:24px;width:auto}
</style>
<div class="pf">
<script>
window.PF = {
  root: {{ routes.root_url | append: '/' | replace: '//', '/' | json }},
  discountCode: "",
  variants: {
    {%- for v in product.variants -%}
      {{ v.title | json }}: {{ v.id }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  },
  sizes: {{ product.options_with_values[0].values | json }},
  sides: {{ product.options_with_values[1].values | json }}
};
</script>

<!-- ============ PRODUCT HERO ============ -->
<section class="wrap hero" id="buy">
  <div class="gallery">
    <div class="main-img"><img id="mainImg" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}"></div>
    <div class="thumbs" id="thumbs">
      {%- for image in product.images -%}
        <button{% if forloop.first %} class="on"{% endif %} data-src="{{ image | image_url: width: 1200 }}" aria-label="Image {{ forloop.index }}"><img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy"></button>
      {%- endfor -%}
    </div>
  </div>

  <div>
    <div class="rating"><span class="stars">★★★★★</span> Rated 4.8 by 526 verified users</div>
    <h1 class="pname">{{ product.title | escape }}</h1>
    <p class="psub">Ergonomic Targeted Knee Compression Sleeve</p>
    <div class="price"><span>{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}<span class="badge">Save 50%</span></div>

    <div class="divider">Single Pair Essential</div>

    <div class="offer on" data-units="2" data-price="57.00">
      <div class="offer-top">
        <span class="radio"></span>
        <div class="offer-info"><div class="offer-title">Buy 1, get 1 Free <span class="badge">SAVE 75%</span></div></div>
        <div class="offer-price">$57.00<s>$226.00</s></div>
      </div>
      <div class="units"></div>
    </div>

    <div class="offer" data-units="4" data-price="114.00">
      <span class="pill">Most popular</span>
      <div class="offer-top">
        <span class="radio"></span>
        <div class="offer-info">
          <div class="offer-title">Buy 2, get 2 Free</div>
          <div><span class="badge">SAVE 75%</span></div>
          <div class="offer-save">Save $338.00</div>
        </div>
        <div class="offer-price">$114.00<s>$452.00</s></div>
      </div>
      <div class="units"></div>
      <div class="gifts">
        <div class="gift"><span class="gi">🎁</span>Stretching Strap With Your Order<b>FREE</b></div>
        <div class="gift"><span class="gi">📘</span>Fit &amp; Comfort Guide<b>FREE</b></div>
      </div>
    </div>

    <button class="btn atc" id="atc">Add to cart</button>
    <div class="pay">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
    <p class="ship">Free shipping included on every order.</p>

    <div class="mini-review">
      <div class="avatar">AT</div>
      <div>
        <div class="stars">★★★★★</div>
        <p>It is comfortable &amp; It actually stays up when I walk.</p>
        <p style="font-size:14px;color:var(--muted);margin-top:4px">Amanda T. <span class="verified">✓ Verified buyer</span></p>
      </div>
    </div>

    <details open><summary>How do I choose my size?</summary><p>Sizing is based on weight ranges from S to XXL to ensure a correct fit.</p></details>
    <details><summary>What is the return policy?</summary><p>Every purchase is backed by a 90-day money-back guarantee.</p></details>
  </div>
</section>

<!-- ============ PAIN POINT ============ -->
<section class="sec pain">
  <div class="wrap split">
    <div>
      <h2 class="title">When every step becomes uncomfortable</h2>
      <p>Then come the moments when you suddenly feel your knee more acutely:
        <b>-Standing up On stairs</b><b>-Sitting for a long time</b><b>- Walking or standing for extended periods</b></p>
    </div>
    <div class="media"><img src="https://cdn.shopify.com/s/files/1/1025/1812/8933/files/97fee8f0-77b8-48be-933e-b1f3b58bb876.webp" alt="Woman holding her knee on the stairs" loading="lazy"></div>
  </div>
</section>

<!-- ============ STORIES CAROUSEL ============ -->
<section class="sec">
  <div class="wrap">
    <h2 class="title">Movement<br>without hesitation.</h2>
    <p class="lead">Reliable joint stability, tested daily by people who refuse to slow down.</p>
  </div>
  <div class="wrap" style="padding:0">
    <div class="stories-track" id="stories">
      <div class="story"><img src="https://cdn.shopify.com/s/files/1/1025/1812/8933/files/8b104e2c-4841-431c-af06-24c1a2889321.webp" alt="" loading="lazy"><div class="cap"><strong>Linda T. <span style="color:#60a5fa">✓</span></strong>"Finally walking more steadily. Left and right specific design stays firmly in place all day."</div></div>
      <div class="story"><img src="https://cdn.shopify.com/s/files/1/1025/1812/8933/files/f57fa532-5843-45d8-8bf8-2641c1e140c3.webp" alt="" loading="lazy"><div class="cap"><strong>Susan K. <span style="color:#60a5fa">✓</span></strong>"Better traction on the stairs. Textured pad delivers focused stability right where it counts."</div></div>
      <div class="story"><img src="https://cdn.shopify.com/s/files/1/1025/1812/8933/files/8ef8f6e8-9dcc-42a5-b3d1-2816e9965c04.webp" alt="" loading="lazy"><div class="cap"><strong>David R. <span style="color:#60a5fa">✓</span></strong>"Snug fit supports long walks without restricting natural movement."</div></div>
    </div>
    <div class="arrows" style="padding:0 16px">
      <button aria-label="Previous" data-scroll="stories" data-dir="-1">←</button>
      <button aria-label="Next" data-scroll="stories" data-dir="1">→</button>
    </div>
  </div>
</section>

<!-- ============ FEATURES ============ -->
<section class="sec features">
  <div class="wrap">
    <h2 class="title">Engineered for<br>joint stability</h2>
    <div class="feat-grid">
      <div class="feat-col">
        <div class="feat"><svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg><h3>Adaptive pressure</h3><p>Regulates tension dynamically around the patella.</p></div>
        <div class="feat"><svg viewBox="0 0 24 24"><path d="M12 2.5l2.4 1.8 3-.2.9 2.9 2.5 1.7-1 2.8 1 2.9-2.5 1.7-.9 2.9-3-.2L12 21.5l-2.4-1.8-3 .2-.9-2.9-2.5-1.7 1-2.9-1-2.8 2.5-1.7.9-2.9 3 .2z"/><path d="m8.5 12 2.3 2.3 4.7-4.6"/></svg><h3>Textured support</h3><p>Cradles the kneecap for impact absorption.</p></div>
        <div class="feat"><svg viewBox="0 0 24 24"><path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg><h3>Left and right</h3><p>Separate shapes for each leg.</p></div>
      </div>
      <div class="media"><img src="https://cdn.shopify.com/s/files/1/1025/1812/8933/files/08c71de7-6a2b-448e-86dc-184477a1823c.webp" alt="Runner wearing the knee sleeve" loading="lazy"></div>
      <div class="feat-col">
        <div class="feat"><svg viewBox="0 0 24 24"><path d="M5 21c.5-4 2.5-7.5 7-10M11 20c-4-1-6-4.5-6-8 0-5 4-9 15-9 0 10-4 15-9 17z"/></svg><h3>Flexible textile</h3><p>Moves naturally with your leg during motion.</p></div>
        <div class="feat"><svg viewBox="0 0 24 24"><path d="M3 3h18v8h-8v4H9v6H3z"/><path d="M7 3v4M11 3v4M15 3v4M3 15h3"/></svg><h3>Slim profile</h3><p>Fits cleanly under jeans without bunching.</p></div>
        <div class="feat"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><h3>Daily support</h3><p>Maintains elasticity through regular wear.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="stats">
  <div class="wrap">
    <div class="stat"><b>500+</b><span>Satisfied users</span></div>
    <div class="stat"><b>4.8</b><span>Average rating</span></div>
    <div class="stat"><b>90</b><span>Day guarantee</span></div>
  </div>
</section>

<!-- ============ SPECIFICATIONS ============ -->
<section class="sec specs">
  <div class="wrap split">
