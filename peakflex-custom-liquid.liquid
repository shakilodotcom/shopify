<script>
(function(){
  /* gallery */
  var main=document.getElementById("mainImg"),thumbs=document.getElementById("thumbs");
  var thumbImg=main.src;
  thumbs.querySelectorAll("button").forEach(function(b){
    b.onclick=function(){main.src=b.dataset.src;thumbs.querySelectorAll("button").forEach(function(x){x.classList.toggle("on",x===b)})};
  });

  /* bundle offers: size + side picker per unit */
  var opts=function(list){return list.map(function(v){return "<option>"+v+"</option>"}).join("")};
  document.querySelectorAll(".offer").forEach(function(offer){
    var html="";
    for(var i=1;i<=+offer.dataset.units;i++){
      html+='<div class="unit"><div class="ut"><img src="'+thumbImg+'" alt=""><span>#'+i+'</span></div>'+
            '<select class="sz" aria-label="Size #'+i+'">'+opts(PF.sizes)+'</select>'+
            '<select class="sd" aria-label="Side #'+i+'">'+opts(PF.sides)+'</select></div>';
    }
    offer.querySelector(".units").innerHTML=html;
    offer.addEventListener("click",function(e){
      if(e.target.closest("select"))return;
      document.querySelectorAll(".offer").forEach(function(o){o.classList.toggle("on",o===offer)});
    });
  });

  /* add to cart: AJAX add, then go to cart */
  var atcBtn=document.getElementById("atc");
  atcBtn.onclick=function(){
    var offer=document.querySelector(".offer.on"),qty={};
    offer.querySelectorAll(".unit").forEach(function(u){
      var id=PF.variants[u.querySelector(".sz").value+" / "+u.querySelector(".sd").value];
      if(id)qty[id]=(qty[id]||0)+1;
    });
    var items=Object.keys(qty).map(function(id){return {id:+id,quantity:qty[id]}});
    atcBtn.disabled=true;atcBtn.textContent="Adding…";
    fetch(PF.root+"cart/add.js",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:items})})
      .then(function(r){if(!r.ok)throw r;return r.json()})
      .then(function(){window.location.href=PF.discountCode?PF.root+"discount/"+encodeURIComponent(PF.discountCode)+"?redirect="+PF.root+"cart":PF.root+"cart"})
      .catch(function(){atcBtn.disabled=false;atcBtn.textContent="Add to cart";alert("Sorry, that size is unavailable. Please choose another.")});
  };

  /* accordions in a group: one open at a time */
  document.querySelectorAll(".acc-group").forEach(function(g){
    g.querySelectorAll("details").forEach(function(d){
      d.addEventListener("toggle",function(){if(d.open)g.querySelectorAll("details").forEach(function(o){if(o!==d)o.open=false})});
    });
  });

  /* carousel arrows */
  document.querySelectorAll("[data-scroll]").forEach(function(b){
    b.onclick=function(){var t=document.getElementById(b.dataset.scroll);t.scrollBy({left:+b.dataset.dir*t.firstElementChild.offsetWidth+16*+b.dataset.dir,behavior:"smooth"})};
  });

  /* review dots */
  var rev=document.getElementById("reviews"),dots=document.getElementById("revDots");
  for(var i=0;i<rev.children.length;i++)dots.appendChild(document.createElement("i"));
  function syncDots(){var w=rev.firstElementChild.offsetWidth+16,n=Math.round(rev.scrollLeft/w);[].forEach.call(dots.children,function(d,i){d.classList.toggle("on",i===n)})}
  rev.addEventListener("scroll",syncDots,{passive:true});syncDots();

  /* sticky bar once the buy box scrolls away */
  var bar=document.getElementById("stickyBar"),atc=document.getElementById("atc");
  new IntersectionObserver(function(e){bar.classList.toggle("show",!e[0].isIntersecting&&e[0].boundingClientRect.top<0)}).observe(atc);
})();
</script>

<div class="sticky-bar" id="stickyBar">
  <img src="{{ product.featured_image | image_url: width: 120 }}" alt="">
  <div class="t">{{ product.title | escape }}<br><span style="color:var(--muted)">{{ product.price | money }}</span></div>
  <a class="btn" href="#buy">Get yours</a>
</div>
</div>
