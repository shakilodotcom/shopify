<div class="sticky" id="tpSticky">
  <div class="wrap">
    <img src="{{ tp_cdn }}AB.webp?width=120" alt="">
    <div class="meta"><h4>{{ product.title | escape }}</h4><div class="pr">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div>
    <button type="button" id="tpStickyAtc">Add to cart</button>
  </div>
</div>

<script>
(function(){
  var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return [].slice.call((r||document).querySelectorAll(s))};

  /* gallery */
  var slides=$("#tpSlides"),thumbs=$("#tpThumbs");
  function go(i){slides.scrollTo({left:i*slides.clientWidth,behavior:"smooth"})}
  $$("button",thumbs).forEach(function(b){b.onclick=function(){go(+b.dataset.i)}});
  slides.addEventListener("scroll",function(){
    var i=Math.round(slides.scrollLeft/slides.clientWidth);
    $$("button",thumbs).forEach(function(b,j){b.classList.toggle("on",i===j)});
  },{passive:true});
  $$("[data-thumbs]").forEach(function(b){b.onclick=function(){
    var n=slides.children.length,i=Math.round(slides.scrollLeft/slides.clientWidth)+(+b.dataset.thumbs);go((i+n)%n);
    thumbs.scrollBy({left:+b.dataset.thumbs*112})}});

  /* size / side pills */
  var sel={size:TPF.sizes[0],side:TPF.sides[0]};
  function pills(el,list,key){
    el.innerHTML=list.map(function(v,i){return '<button type="button"'+(i?'':' class="on"')+'>'+v+'</button>'}).join("");
    $$("button",el).forEach(function(b){b.onclick=function(){
      sel[key]=b.textContent;$$("button",el).forEach(function(x){x.classList.toggle("on",x===b)});
      $$(".pkg .unit "+(key==="size"?".sz":".sd")).forEach(function(s){s.value=sel[key]});
    }});
  }
  pills($("#tpSize"),TPF.sizes,"size");pills($("#tpSide"),TPF.sides,"side");

  /* packages */
  function opts(list){return list.map(function(v){return "<option>"+v+"</option>"}).join("")}
  $$(".tpf .pkg").forEach(function(p){
    var n=+p.dataset.units,box=$(".units",p);
    if(box){
      var h='<div class="hint">Size, Side</div>';
      for(var i=1;i<=n;i++)h+='<div class="unit"><span>#'+i+'</span><select class="sz" aria-label="Size #'+i+'">'+opts(TPF.sizes)+'</select><select class="sd" aria-label="Side #'+i+'">'+opts(TPF.sides)+'</select></div>';
      box.innerHTML=h;
    }
    p.addEventListener("click",function(e){
      if(e.target.closest("select"))return;
      $$(".tpf .pkg").forEach(function(o){o.classList.toggle("on",o===p)});
    });
  });

  /* add to cart */
  var atc=$("#tpAtc");
  function addToCart(){
    var p=$(".tpf .pkg.on"),qty={},ids=[];
    if(+p.dataset.units===1){ids.push(TPF.variants[sel.size+" / "+sel.side])}
    else $$(".unit",p).forEach(function(u){ids.push(TPF.variants[$(".sz",u).value+" / "+$(".sd",u).value])});
    ids.forEach(function(id){if(id)qty[id]=(qty[id]||0)+1});
    var items=Object.keys(qty).map(function(id){return {id:+id,quantity:qty[id]}});
    atc.disabled=true;atc.textContent="Adding…";
    fetch(TPF.root+"cart/add.js",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:items})})
      .then(function(r){if(!r.ok)throw r;return r.json()})
      .then(function(){location.href=TPF.discountCode?TPF.root+"discount/"+encodeURIComponent(TPF.discountCode)+"?redirect="+TPF.root+"cart":TPF.root+"cart"})
      .catch(function(){atc.disabled=false;atc.textContent="Add to cart";alert("Sorry, that size is unavailable. Please choose another.")});
  }
  atc.onclick=addToCart;
  $("#tpStickyAtc").onclick=addToCart;

  /* dialogs */
  $$("[data-open]").forEach(function(b){b.onclick=function(){var d=document.getElementById(b.dataset.open);d.showModal?d.showModal():d.setAttribute("open","")}});
  $$(".tpf dialog").forEach(function(d){
    $$("[data-close]",d).forEach(function(b){b.onclick=function(){d.close()}});
    d.addEventListener("click",function(e){if(e.target===d)d.close()});
  });

  /* sticky bar once the main button has scrolled away */
  var bar=$("#tpSticky");
  new IntersectionObserver(function(e){bar.classList.toggle("show",!e[0].isIntersecting&&e[0].boundingClientRect.top<0)}).observe(atc);
})();
</script>
</div>
